{
  "name": "sap-flow-atlas",
  "private": true,
  "description": "SAP Flow Atlas — a visual, human-facing knowledge base for SAP modules, business flows, and ABAP objects.",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content:build": "tsx scripts/build-content.ts",
    "content:validate": "tsx scripts/build-content.ts --check",
    "content:report": "tsx scripts/content-report.ts",
    "precontent:report": "pnpm content:build",
    "content:catalog": "tsx scripts/content-catalog.ts",
    "precontent:catalog": "pnpm content:build",
    "pretypecheck": "pnpm content:build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm content:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm content:build && vite",
    "build": "pnpm content:build && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
